# Codex Wise environment variables
# Copy this file to .env and fill in local values.

# Provider keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional database override
CODEX_WISE_DB_URL=sqlite+aiosqlite:///./codex-wise.db

# Optional server protection for shared/network use
CODEX_WISE_API_KEY=
CODEX_WISE_HOST=127.0.0.1

# Search/RAG embedder
CODEX_WISE_EMBEDDER=mock
# Optional model overrides.
# Gemini direct API default: gemini-embedding-2
# OpenAI default: text-embedding-3-small
# CODEX_WISE_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# CODEX_WISE_EMBEDDING_MODEL=text-embedding-3-small
# CODEX_WISE_EMBEDDING_DIMS=768
# CODEX_WISE_GEMINI_EMBEDDING_QUERY_TASK=code retrieval

# Webhook secrets
CODEX_WISE_GITHUB_WEBHOOK_SECRET=
CODEX_WISE_GITLAB_WEBHOOK_TOKEN=
