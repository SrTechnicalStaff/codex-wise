# Codex Wise Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# LLM Provider Configuration
# ---------------------------------------------------------------------------

# Codex app-server (preferred inside Codex Desktop / Codex plugin launches)
CODEX_WISE_PROVIDER=codex_app
CODEX_WISE_CODEX_TRANSPORT=proxy
# Optional: choose a Codex model for internal commands such as get_answer
# CODEX_WISE_MODEL=gpt-5.4-mini
# CODEX_WISE_CODEX_TIMEOUT_SECONDS=60

# API-key providers for non-Codex/headless environments
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI
# OPENAI_API_KEY=your_openai_api_key_here

# Ollama — no API key needed, but set base URL if non-default
# OLLAMA_BASE_URL=http://localhost:11434

# LiteLLM proxy (for Together AI, Replicate, Groq, etc.)
# LITELLM_API_KEY=your_litellm_key_here
# LITELLM_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQLite (default, no setup required)
DATABASE_URL=sqlite+aiosqlite:///./repowise.db

# PostgreSQL (optional, for production deployments)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/repowise

# ---------------------------------------------------------------------------
# Storage Paths
# ---------------------------------------------------------------------------

# LanceDB vector store path (used when DATABASE_URL is SQLite)
# When DATABASE_URL is PostgreSQL, pgvector is used instead — no separate path needed
LANCEDB_PATH=./data/lancedb

# Dependency graph storage path
GRAPH_PATH=./data/graphs

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Optional API key to protect Codex Wise API endpoints
# Leave empty for fully open access (suitable for local use)
CODEX_WISE_API_KEY=

# Server bind address and port
CODEX_WISE_HOST=0.0.0.0
CODEX_WISE_PORT=7337

# MCP server port (SSE transport)
CODEX_WISE_MCP_PORT=7338

# ---------------------------------------------------------------------------
# Generation Defaults
# ---------------------------------------------------------------------------

# Default provider: codex_app | anthropic | openai | ollama | litellm
CODEX_WISE_DEFAULT_PROVIDER=codex_app

# Default model (depends on provider)
CODEX_WISE_DEFAULT_MODEL=claude-sonnet-4-6

# Max concurrent LLM calls during generation
CODEX_WISE_MAX_CONCURRENT=5

# Max pages to regenerate per maintenance run
CODEX_WISE_CASCADE_BUDGET=30

# ---------------------------------------------------------------------------
# Development
# ---------------------------------------------------------------------------

# Set to "true" to enable debug logging
CODEX_WISE_DEBUG=false

# Log level: DEBUG | INFO | WARNING | ERROR
CODEX_WISE_LOG_LEVEL=INFO

# Legacy REPOWISE_* variables are still accepted for compatibility.
